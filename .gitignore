# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/

# --- Virtuelle Umgebung ---
.venv/
venv/
env/

# --- Messdaten aus den Spieldurchläufen ---
# Enthalten Rohdaten der Versuchspersonen -> gehören NICHT ins Repo (Datenschutz).
logs/*
!logs/.gitkeep

# --- Test- und Tooling-Caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- IDE / Betriebssystem ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Arbeitsdateien der Claude-Code-Sitzungen ---
# Gesprächsmitschnitte aus /export (Dateiname beginnt mit dem Datum) und
# Zwischenstände. Gehören nicht ins Repo: Sie sind Arbeitsmaterial, blähen
# die Historie auf und können Pfade oder Inhalte enthalten, die nicht
# veröffentlicht werden sollen.
resume.txt
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
